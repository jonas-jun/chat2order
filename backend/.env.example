# 로컬 개발용: 이 파일을 .env.local 로 복사하여 값을 채운다 (.env.local 은 git ignore)
# 프로덕션은 Cloud Run Secret Manager 마운트 (--set-secrets)

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# --- 도로명주소 (Juso) ---
JUSO_API_KEY=

# --- JWT ---
# 운영 환경에서는 충분히 긴 랜덤 시크릿 사용 (예: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Cookie ---
# 로컬(http) 개발 시 false. 프로덕션(HTTPS)은 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# JSON 배열 형식 (운영에서는 frontend Cloud Run 도메인만 허용)
CORS_ORIGINS=["http://localhost:3000"]

# --- Prompts (multiline; "..." 로 감싸기) ---
PROMPT_ORDER_EXTRACTION=""
PROMPT_ADDRESS_TO_SEARCH=""
